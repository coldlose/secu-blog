---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../config';
// About 내용은 /admin → "About 페이지" 메뉴에서 수정합니다. (src/data/about.json)
import about from '../data/about.json';

const blocks = [
  { title: 'Awards', sub: '수상', items: about.awards ?? [] },
  { title: 'Certificates', sub: '자격증', items: about.certificates ?? [] },
  { title: 'Activities', sub: '활동', items: about.activities ?? [] },
  { title: 'Education', sub: '학력', items: about.education ?? [] },
];
---

<BaseLayout title="About" current="/about">
  <section class="page-head">
    <h1>About</h1>
  </section>

  <hr class="rule" />

  <div class="profile">
    <img
      class="p-photo"
      src="/images/profile.png"
      alt={`${AUTHOR.name} 프로필`}
      width="148"
      height="148"
    />

    <div class="p-intro">
      <p class="eyebrow">{AUTHOR.role}</p>
      <div class="p-name">이찬진 <span>Lee ChanJin</span></div>
      <p class="p-bio">{AUTHOR.bio}<br />{AUTHOR.field}</p>
    </div>

    <div class="p-contact">
      <div class="row">
        <span class="k">EMAIL</span>
        <a class="v" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
      </div>
      <div class="row">
        <span class="k">GITHUB</span>
        <a class="v" href={AUTHOR.github} target="_blank" rel="noopener">{AUTHOR.githubLabel}</a>
      </div>
      <div class="row">
        <span class="k">LOCATION</span>
        <span class="v plain">{AUTHOR.location}</span>
      </div>
    </div>
  </div>

  <hr class="rule" style="margin-top: 40px" />

  {
    blocks.map((block) => (
      <section class="about-block">
        <h2>
          <span class="t-en">{block.title}</span>
          <span class="sep">·</span>
          <span class="sub-inline">{block.sub}</span>
        </h2>
        <ul class="timeline">
          {block.items.map((item) => (
            <li class={item.when ? undefined : 'no-date'}>
              {item.when && <span class="when">{item.when}</span>}
              <span class="what">
                <span class="main">{item.main}</span>
                {item.by && <span class="by">{item.by}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
